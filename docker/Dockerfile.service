FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /src
COPY . .

ARG MODULE
RUN test -n "$MODULE"

# Optional: use a Maven mirror if Maven Central TLS is flaky in your network.
# Example: https://maven.aliyun.com/repository/central
ARG MAVEN_MIRROR_URL=""
# Optional: allow insecure TLS (NOT recommended). Use only for temporary debugging.
ARG MAVEN_INSECURE_SSL="false"

# Build only the requested module (and its deps) as a runnable Spring Boot jar.
RUN --mount=type=cache,target=/root/.m2 \
  set -eux; \
  mkdir -p /root/.m2; \
  if [ -n "$MAVEN_MIRROR_URL" ]; then \
    printf '%s\n' \
      '<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">' \
      '  <mirrors>' \
      '    <mirror>' \
      '      <id>mirror-central</id>' \
      '      <mirrorOf>central</mirrorOf>' \
      "      <url>${MAVEN_MIRROR_URL}</url>" \
      '    </mirror>' \
      '  </mirrors>' \
      '</settings>' \
      > /root/.m2/settings.xml; \
  fi; \
  EXTRA_SSL_ARGS=""; \
  if [ "$MAVEN_INSECURE_SSL" = "true" ]; then \
    EXTRA_SSL_ARGS="-Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true"; \
  fi; \
  ./mvnw -B -q -pl "$MODULE" -am -DskipTests \
    -U \
    -Dmaven.wagon.http.retryHandler.count=5 \
    -Dmaven.wagon.http.retryHandler.requestSentEnabled=true \
    $EXTRA_SSL_ARGS \
    package

# Pick the repackaged jar (exclude *.jar.original) and normalize name for runtime image.
RUN set -eux; \
  JAR_PATH="$(ls -1 "$MODULE"/target/*.jar | grep -v '\\.jar\\.original$' | head -n 1)"; \
  test -f "$JAR_PATH"; \
  mkdir -p /out; \
  cp "$JAR_PATH" /out/app.jar

FROM eclipse-temurin:21-jre

WORKDIR /app
ENV TZ=Asia/Shanghai

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/app.jar /app/app.jar
COPY docker/wait-for-url.sh /usr/local/bin/wait-for-url
RUN chmod +x /usr/local/bin/wait-for-url

ENV JAVA_OPTS=""
ENV WAIT_FOR_URL=""
ENV WAIT_FOR_TEXT=""
ENV WAIT_FOR_TIMEOUT_SECONDS="120"
ENV WAIT_FOR_INTERVAL_SECONDS="2"

ENTRYPOINT ["sh", "-c", "if [ -n \"$WAIT_FOR_URL\" ]; then wait-for-url \"$WAIT_FOR_URL\" \"$WAIT_FOR_TEXT\" \"$WAIT_FOR_TIMEOUT_SECONDS\" \"$WAIT_FOR_INTERVAL_SECONDS\"; fi; exec java $JAVA_OPTS -jar /app/app.jar"]
